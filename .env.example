# AgentOS environment example.
# Copy this file to .env for local development.
# Never commit .env or real secrets.

# AI provider keys are optional for the public prototype.
# The local Ollama path is the default baseline.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram runtime setup.
# These values are user/runtime configuration and must not be baked into an ISO.
AGENTOS_TELEGRAM_BOT_TOKEN=
AGENTOS_TELEGRAM_ALLOWED_CHAT_IDS=

# Workspace path for local development.
DEFAULT_WORKSPACE=./workspaces/default

# User-owned data root for local/Docker Phase 2 preview output.
AGENTOS_USER_DATA_ROOT=./agentos-data/user

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING
