[Unit]
Description=AgentOS Telegram Live Loop Daemon
After=network-online.target agentos-ollama.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=AGENTOS_DEFAULT_WORKSPACE=/home/ubuntu/agentos-ws
Environment=AGENTOS_KERNELCTL_BIN=/usr/local/bin/agentos-kernelctl
Environment=AGENTOS_TELEGRAM_DAEMON_INTERVAL_SEC=5
EnvironmentFile=-/etc/agentos/daemon.env
EnvironmentFile=-/home/ubuntu/.config/agentos/env
ExecStart=/usr/local/bin/agentos-telegram-live-loop-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
