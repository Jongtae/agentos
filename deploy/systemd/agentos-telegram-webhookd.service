[Unit]
Description=AgentOS Telegram Webhook Receiver Daemon
After=network-online.target agentos-ollama.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=AGENTOS_DEFAULT_WORKSPACE=/home/ubuntu/agentos-ws
Environment=AGENTOS_RUNTIME_ROOT=/usr/lib/agentos
Environment=AGENTOS_TELEGRAM_WEBHOOK_HOST=0.0.0.0
Environment=AGENTOS_TELEGRAM_WEBHOOK_PORT=8790
Environment=AGENTOS_TELEGRAM_WEBHOOK_PATH=/telegram/webhook
EnvironmentFile=-/etc/agentos/daemon.env
EnvironmentFile=-/home/ubuntu/.config/agentos/env
ExecStart=/usr/local/bin/agentos-telegram-webhook-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
