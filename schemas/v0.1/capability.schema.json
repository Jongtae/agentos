{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agentos.dev/schemas/v0.1/capability.schema.json",
  "title": "Personal AgentOS v0.1 Capability",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "Capability"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentos:capability:[a-z0-9][a-z0-9._-]{0,95}$",
      "maxLength": 150
    },
    "revision": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/revision"
    },
    "createdAt": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/timestamp"
    },
    "authority": {
      "const": "agentos"
    },
    "ownerRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Owner"
            },
            "id": {
              "pattern": "^urn:agentos:owner:"
            }
          }
        }
      ]
    },
    "provenance": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/provenance"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,95}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/action"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "packageRef": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "AgentPackage"
                },
                "id": {
                  "pattern": "^urn:agentos:agent-package:"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeRefs": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
          },
          {
            "properties": {
              "kind": {
                "const": "Runtime"
              },
              "id": {
                "pattern": "^urn:agentos:runtime:"
              }
            }
          }
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "inputArtifactTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 64
    },
    "outputArtifactTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 64
    },
    "authorization": {
      "const": "currentWorkGrant"
    },
    "approvalPolicy": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/approvalPolicy"
    },
    "state": {
      "enum": [
        "registered",
        "disabled",
        "removed"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revision",
    "createdAt",
    "authority",
    "ownerRef",
    "provenance",
    "name",
    "description",
    "actions",
    "packageRef",
    "runtimeRefs",
    "inputArtifactTypes",
    "outputArtifactTypes",
    "authorization",
    "approvalPolicy",
    "state"
  ]
}
