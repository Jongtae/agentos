{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agentos.dev/schemas/v0.1/context-snapshot.schema.json",
  "title": "Personal AgentOS v0.1 ContextSnapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "ContextSnapshot"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentos:context-snapshot:[a-z0-9][a-z0-9._-]{0,95}$",
      "maxLength": 150
    },
    "revision": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/revision"
    },
    "createdAt": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/timestamp"
    },
    "authority": {
      "const": "agentos"
    },
    "ownerRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Owner"
            },
            "id": {
              "pattern": "^urn:agentos:owner:"
            }
          }
        }
      ]
    },
    "provenance": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/provenance"
    },
    "workRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Work"
            },
            "id": {
              "pattern": "^urn:agentos:work:"
            }
          }
        }
      ]
    },
    "contextRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Context"
            },
            "id": {
              "pattern": "^urn:agentos:context:"
            }
          }
        }
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
              },
              {
                "properties": {
                  "kind": {
                    "const": "Artifact"
                  },
                  "id": {
                    "pattern": "^urn:agentos:artifact:"
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
              },
              {
                "properties": {
                  "kind": {
                    "const": "Memory"
                  },
                  "id": {
                    "pattern": "^urn:agentos:memory:"
                  }
                }
              }
            ]
          }
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "contentRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Resource"
            },
            "id": {
              "pattern": "^urn:agentos:resource:"
            }
          }
        }
      ]
    },
    "effectiveGrantRefs": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
          },
          {
            "properties": {
              "kind": {
                "const": "Grant"
              },
              "id": {
                "pattern": "^urn:agentos:grant:"
              }
            }
          }
        ]
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 64
    },
    "expiresAt": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/timestamp"
    },
    "redactionApplied": {
      "const": true
    },
    "sharing": {
      "const": "workOnly"
    },
    "canonicalMemoryAuthority": {
      "const": false
    },
    "readOnly": {
      "const": true
    },
    "recipientRuntimeRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Runtime"
            },
            "id": {
              "pattern": "^urn:agentos:runtime:"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revision",
    "createdAt",
    "authority",
    "ownerRef",
    "provenance",
    "workRef",
    "contextRef",
    "sourceRefs",
    "contentRef",
    "effectiveGrantRefs",
    "expiresAt",
    "redactionApplied",
    "sharing",
    "canonicalMemoryAuthority",
    "readOnly",
    "recipientRuntimeRef"
  ]
}
