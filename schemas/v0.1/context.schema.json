{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agentos.dev/schemas/v0.1/context.schema.json",
  "title": "Personal AgentOS v0.1 Context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "Context"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:agentos:context:[a-z0-9][a-z0-9._-]{0,95}$",
      "maxLength": 150
    },
    "revision": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/revision"
    },
    "createdAt": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/timestamp"
    },
    "authority": {
      "const": "agentos"
    },
    "ownerRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Owner"
            },
            "id": {
              "pattern": "^urn:agentos:owner:"
            }
          }
        }
      ]
    },
    "provenance": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/provenance"
    },
    "workRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Work"
            },
            "id": {
              "pattern": "^urn:agentos:work:"
            }
          }
        }
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
              },
              {
                "properties": {
                  "kind": {
                    "const": "Artifact"
                  },
                  "id": {
                    "pattern": "^urn:agentos:artifact:"
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
              },
              {
                "properties": {
                  "kind": {
                    "const": "Memory"
                  },
                  "id": {
                    "pattern": "^urn:agentos:memory:"
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
              },
              {
                "properties": {
                  "kind": {
                    "const": "Event"
                  },
                  "id": {
                    "pattern": "^urn:agentos:event:"
                  }
                }
              }
            ]
          }
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "contentRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Resource"
            },
            "id": {
              "pattern": "^urn:agentos:resource:"
            }
          }
        }
      ]
    },
    "sensitivity": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/sensitivity"
    },
    "expiresAt": {
      "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/timestamp"
    },
    "captureConsent": {
      "const": "ownerOptIn"
    },
    "sensitiveDataFiltered": {
      "const": true
    },
    "state": {
      "enum": [
        "available",
        "expired",
        "deleted"
      ]
    },
    "canonicalMemory": {
      "const": false
    },
    "recipientRuntimeRef": {
      "allOf": [
        {
          "$ref": "https://personal-agentos.dev/schemas/v0.1/common.schema.json#/$defs/immutableRef"
        },
        {
          "properties": {
            "kind": {
              "const": "Runtime"
            },
            "id": {
              "pattern": "^urn:agentos:runtime:"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revision",
    "createdAt",
    "authority",
    "ownerRef",
    "provenance",
    "workRef",
    "sourceRefs",
    "contentRef",
    "sensitivity",
    "expiresAt",
    "captureConsent",
    "sensitiveDataFiltered",
    "state",
    "canonicalMemory",
    "recipientRuntimeRef"
  ]
}
