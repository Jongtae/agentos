usage() {
  cat <<USAGE
Usage:
  agentos-kernelctl status [--workspace <path>] [--policy-dir <path>] [--parser-cmd <cmd>] [--json]
  agentos-kernelctl doctor [--workspace <path>] [--json]
  agentos-kernelctl preflight [--workspace <path>]
  agentos-kernelctl health [--workspace <path>] [--policy-dir <path>] [--parser-cmd <cmd>] [--json]
  agentos-kernelctl audit [--workspace <path>] [--install-root <path>] [--json]
  agentos-kernelctl repair [--workspace <path>] [--install-root <path>] [--checks <names>] [--list-checks] [--report-file <path>] [--report-dir <path>] [--report-retain <N>] [--dry-run] [--json]
  agentos-kernelctl report-status [--report-dir <path>] [--json]
  agentos-kernelctl broker-status [--workspace <path>] [--json]
  agentos-kernelctl evidence [--workspace <path>] [--install-root <path>] [--metadata <path>] [--json]
  agentos-kernelctl replay [--workspace <path>] [--session-id <id>] [--limit <N>] [--json]
  agentos-kernelctl approval-forensics [--workspace <path>] [--session-id <id>] [--limit <N>] [--json]
  agentos-kernelctl case-export [--workspace <path>] [--session-id <id>] [--limit <N>] [--install-root <path>] [--metadata <path>] [--output <path>] [--json]
  agentos-kernelctl validation-window [--workspace <path>] [--install-root <path>] [--metadata <path>] [--diagnostics-manifest <path>] [--report-dir <path>] [--snapshot-label <label>] [--output <path>] [--json]
  agentos-kernelctl control-history [--workspace <path>] [--limit <N>] [--output <path>] [--json]
  agentos-kernelctl review-pack [--workspace <path>] [--session-id <id>] [--limit <N>] [--install-root <path>] [--metadata <path>] [--diagnostics-manifest <path>] [--report-dir <path>] [--snapshot-label <label>] [--output <path>] [--json]
