    ;;
  policy-correlation)
    if [ ! -x "$POLICY_CORRELATION_CMD" ] && ! command -v "$POLICY_CORRELATION_CMD" >/dev/null 2>&1; then
      echo "policy correlation tool not found: $POLICY_CORRELATION_CMD"
      exit 1
    fi
    correlation_args=(--workspace "$workspace")
    if [ "$as_json" -eq 1 ]; then
      correlation_args+=(--json)
    fi
    exec "$POLICY_CORRELATION_CMD" "${correlation_args[@]}"
    ;;
  firstrun-reset)
    if [ ! -x "$FIRSTRUN_RESET_CMD" ] && ! command -v "$FIRSTRUN_RESET_CMD" >/dev/null 2>&1; then
      echo "firstrun reset tool not found: $FIRSTRUN_RESET_CMD"
      exit 1
    fi
    reset_args=(--workspace "$workspace")
    if [ -n "$user_home" ]; then
      reset_args+=(--user-home "$user_home")
    fi
    if [ "$as_json" -eq 1 ]; then
      reset_args+=(--json)
    fi
    exec "$FIRSTRUN_RESET_CMD" "${reset_args[@]}"
    ;;
  policy-bridge)
    if [ ! -x "$POLICY_BRIDGE_CMD" ] && ! command -v "$POLICY_BRIDGE_CMD" >/dev/null 2>&1; then
      echo "kernel policy bridge tool not found: $POLICY_BRIDGE_CMD"
      exit 1
    fi
    bridge_args=(--workspace "$workspace")
    if [ -n "$out_dir" ]; then
      bridge_args+=(--output-dir "$out_dir")
    fi
    if [ "$reload_profile" -eq 1 ]; then
      bridge_args+=(--reload)
    fi
    if [ "$policy_disable" -eq 1 ]; then
      bridge_args+=(--disable)
    fi
    if [ -n "$policy_parser_cmd" ]; then
      bridge_args+=(--parser-cmd "$policy_parser_cmd")
    fi
    if [ "$as_json" -eq 1 ]; then
      bridge_args+=(--json)
    fi
    exec "$POLICY_BRIDGE_CMD" "${bridge_args[@]}"
    ;;
  policy-shadow)
    if [ ! -x "$POLICY_SHADOW_CMD" ] && ! command -v "$POLICY_SHADOW_CMD" >/dev/null 2>&1; then
      echo "kernel policy shadow tool not found: $POLICY_SHADOW_CMD"
      exit 1
    fi
    shadow_args=(--workspace "$workspace")
    if [ -n "$out_dir" ]; then
      shadow_args+=(--output "$out_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      shadow_args+=(--json)
    fi
    exec "$POLICY_SHADOW_CMD" "${shadow_args[@]}"
    ;;
  policy-enforce)
    if [ ! -x "$POLICY_ENFORCE_CMD" ] && ! command -v "$POLICY_ENFORCE_CMD" >/dev/null 2>&1; then
      echo "kernel policy enforce tool not found: $POLICY_ENFORCE_CMD"
      exit 1
    fi
    enforce_args=(--workspace "$workspace")
    if [ "$policy_enable" -eq 1 ]; then
      enforce_args+=(--enable)
    fi
    if [ "$policy_disable" -eq 1 ]; then
      enforce_args+=(--disable)
    fi
    if [ "$policy_status" -eq 1 ]; then
      enforce_args+=(--status)
    fi
    if [ "$policy_confirm" -eq 1 ]; then
      enforce_args+=(--confirm)
    fi
    if [ "$policy_require_ready" -eq 1 ]; then
      enforce_args+=(--require-ready)
    fi
    if [ -n "$policy_target" ]; then
      enforce_args+=(--policy-target "$policy_target")
    fi
    if [ -n "$policy_dir" ]; then
      enforce_args+=(--policy-dir "$policy_dir")
    fi
    if [ -n "$policy_parser_cmd" ]; then
      enforce_args+=(--parser-cmd "$policy_parser_cmd")
    fi
    if [ "$as_json" -eq 1 ]; then
      enforce_args+=(--json)
    fi
    exec "$POLICY_ENFORCE_CMD" "${enforce_args[@]}"
    ;;
  policy-ready)
    if [ ! -x "$POLICY_READY_CMD" ] && ! command -v "$POLICY_READY_CMD" >/dev/null 2>&1; then
      echo "kernel policy readiness tool not found: $POLICY_READY_CMD"
      exit 1
    fi
    ready_args=(--workspace "$workspace")
    if [ -n "$policy_dir" ]; then
      ready_args+=(--policy-dir "$policy_dir")
    fi
    if [ -n "$policy_parser_cmd" ]; then
      ready_args+=(--parser-cmd "$policy_parser_cmd")
    fi
    if [ "$as_json" -eq 1 ]; then
      ready_args+=(--json)
    fi
    exec "$POLICY_READY_CMD" "${ready_args[@]}"
    ;;
  restart)
    if ! command -v "$SYSTEMCTL_CMD" >/dev/null 2>&1; then
      echo "systemctl not found"
      exit 1
    fi
    exec "$SYSTEMCTL_CMD" restart "$SERVICE_NAME"
    ;;
  logs)
    if ! command -v "$JOURNALCTL_CMD" >/dev/null 2>&1; then
      echo "journalctl not found"
      exit 1
    fi
    exec "$JOURNALCTL_CMD" -u "$SERVICE_NAME" -n "$lines" --no-pager
    ;;
  bundle)
    if [ ! -x "$EXPORT_DIAG_CMD" ] && ! command -v "$EXPORT_DIAG_CMD" >/dev/null 2>&1; then
      echo "diagnostics exporter not found: $EXPORT_DIAG_CMD"
      exit 1
    fi
    if [ -n "$out_dir" ]; then
      exec "$EXPORT_DIAG_CMD" "$workspace" "$out_dir"
    fi
    exec "$EXPORT_DIAG_CMD" "$workspace"
    ;;
  *)
    usage
    exit 2
    ;;
esac
