run_systemctl() {
  if ! command -v "$SYSTEMCTL_CMD" >/dev/null 2>&1; then
    return 127
  fi
  "$SYSTEMCTL_CMD" "$@"
}

case "$subcmd" in
  status)
    if command -v "$SYSTEMCTL_CMD" >/dev/null 2>&1; then
      state="$(run_systemctl is-active "$SERVICE_NAME" 2>/dev/null || true)"
      enabled="$(run_systemctl is-enabled "$SERVICE_NAME" 2>/dev/null || true)"
      svc_available=1
    else
      state="unavailable (systemctl not found)"
      enabled="unavailable (systemctl not found)"
      svc_available=0
    fi

    shell_json="$("$SHELL_CMD" --workspace "$workspace" --status --json 2>/dev/null || true)"
    ready_args=(--workspace "$workspace" --json)
    if [ -n "$policy_dir" ]; then
      ready_args+=(--policy-dir "$policy_dir")
    fi
    if [ -n "$policy_parser_cmd" ]; then
      ready_args+=(--parser-cmd "$policy_parser_cmd")
    fi
    policy_json="$("$POLICY_READY_CMD" "${ready_args[@]}" 2>/dev/null || true)"

    if [ "$as_json" -eq 1 ]; then
      python3 - "$SERVICE_NAME" "$state" "$enabled" "$svc_available" "$shell_json" "$policy_json" <<'PY'
import json
import sys

service_name = sys.argv[1]
state = sys.argv[2]
enabled = sys.argv[3]
svc_available = bool(int(sys.argv[4]))
shell_raw = sys.argv[5]
policy_raw = sys.argv[6]

def _parse(raw: str) -> dict:
    if not raw:
        return {}
    try:
        obj = json.loads(raw)
        return obj if isinstance(obj, dict) else {}
    except Exception:
        return {}

runtime = _parse(shell_raw)
policy = _parse(policy_raw)

ok = bool(runtime.get("ok", False))
if not svc_available:
    service_healthy = True
else:
    service_healthy = state in {"active", "activating"}
ok = ok and bool(service_healthy)
if policy:
    overall = str(policy.get("overall_status", "warn")).lower()
    ok = ok and overall in {"pass", "warn"}

payload = {
    "ok": bool(ok),
    "exit_code": 0 if ok else 1,
    "service": {
        "name": service_name,
        "available": svc_available,
        "active": state,
        "enabled": enabled,
        "healthy": bool(service_healthy),
    },
    "runtime_status": runtime,
    "policy_ready": policy,
    "recovery_hints": {
        "path_label": "AgentOS Recovery",
        "path_description": "Beginner-safe recovery path for reaching a normal shell, bypassing broker mediation temporarily, or removing managed entry assets.",
        "recommended_rejoin_summary": [
            "AgentOS Recovery",
            "Return to AgentOS",
            "ai>",
        ],
        "recommended_rejoin_path": [
            "AgentOS Recovery",
            "AgentOS Setup",
            "AgentOS Managed Session",
            "ai>",
        ],
        "tty_bypass_env": "AGENTOS_BOOT_AUTOSTART=0",
        "broker_bypass_env": "AGENTOS_BROKER_BYPASS=1",
        "broker_override_env": "AGENTOS_BROKER_OVERRIDE=1",
        "uninstall_cmd": "sudo scripts/uninstall_kernel_boot_integration.sh",
        "recovery_ladder": [
            {
                "level": 1,
                "name": "normal_shell_fallback",
                "trigger": "AGENTOS_BOOT_AUTOSTART=0",
                "use_when": "managed tty1 entry must be skipped entirely",
            },
            {
                "level": 2,
                "name": "managed_entry_broker_bypass",
                "trigger": "AGENTOS_BROKER_BYPASS=1",
                "use_when": "managed entry should continue while broker mediation is temporarily bypassed",
            },
            {
                "level": 3,
                "name": "managed_entry_override",
                "trigger": "AGENTOS_BROKER_OVERRIDE=1",
                "use_when": "managed entry should continue while override evidence is still emitted",
            },
            {
                "level": 4,
                "name": "full_uninstall",
                "trigger": "sudo scripts/uninstall_kernel_boot_integration.sh",
                "use_when": "managed entry assets must be removed completely",
            },
        ],
    },
}

print(json.dumps(payload, ensure_ascii=True))
raise SystemExit(int(payload["exit_code"]))
PY
      exit $?
    fi

    echo "managed_session_service: $SERVICE_NAME"
    echo "active: ${state:-unknown}"
    echo "enabled: ${enabled:-unknown}"
    if [ -n "$policy_json" ]; then
      python3 - "$policy_json" <<'PY'
import json
import sys

raw = sys.argv[1]
try:
    payload = json.loads(raw)
except Exception:
    payload = {}

if payload:
    print(f"policy_ready: {payload.get('overall_status', 'unknown')}")
    print(f"policy_ready_enforced: {bool((payload.get('enforced_pilot', {}) or {}).get('effective_enabled', False))}")
else:
    print("policy_ready: unavailable")
PY
    fi
    echo "Recovery path: AgentOS Recovery"
    echo "Recovery hints:"
    echo "  - AGENTOS_BOOT_AUTOSTART=0 keeps tty1 on the normal login shell"
    echo "  - AGENTOS_BROKER_BYPASS=1 bypasses broker mediation during recovery sessions"
    echo "  - AGENTOS_BROKER_OVERRIDE=1 keeps AgentOS entry active while emitting override events"
    echo "  - sudo scripts/uninstall_kernel_boot_integration.sh removes managed entry assets"
    echo "  - recovery summary: AgentOS Recovery -> Return to AgentOS -> ai>"
    echo "  - detailed rejoin path: AgentOS Recovery -> AgentOS Setup -> AgentOS Managed Session -> ai>"
    echo "Recovery ladder:"
    echo "  1. normal shell fallback -> AGENTOS_BOOT_AUTOSTART=0"
    echo "  2. managed entry with broker bypass -> AGENTOS_BROKER_BYPASS=1"
    echo "  3. managed entry with override evidence -> AGENTOS_BROKER_OVERRIDE=1"
    echo "  4. full uninstall of managed entry assets -> sudo scripts/uninstall_kernel_boot_integration.sh"
    exec "$SHELL_CMD" --workspace "$workspace" --status
    ;;
  preflight)
    if [ "$as_json" -eq 1 ]; then
      exec "$SHELL_CMD" --workspace "$workspace" --preflight --json
    fi
    exec "$SHELL_CMD" --workspace "$workspace" --preflight
    ;;
  doctor)
    if [ "$as_json" -eq 1 ]; then
      exec "$SHELL_CMD" --workspace "$workspace" --doctor --json
    fi
    exec "$SHELL_CMD" --workspace "$workspace" --doctor
    ;;
  health)
    if [ ! -x "$HEALTHCHECK_CMD" ] && ! command -v "$HEALTHCHECK_CMD" >/dev/null 2>&1; then
      echo "healthcheck tool not found: $HEALTHCHECK_CMD"
      exit 1
    fi
    if [ "$as_json" -eq 1 ]; then
      health_args=(--workspace "$workspace" --service-name "$SERVICE_NAME" --systemctl-cmd "$SYSTEMCTL_CMD")
      if [ -n "$policy_dir" ]; then
        health_args+=(--policy-dir "$policy_dir")
      fi
      if [ -n "$policy_parser_cmd" ]; then
        health_args+=(--policy-parser-cmd "$policy_parser_cmd")
      fi
      health_args+=(--json)
      exec "$HEALTHCHECK_CMD" "${health_args[@]}"
    fi
    health_args=(--workspace "$workspace" --service-name "$SERVICE_NAME" --systemctl-cmd "$SYSTEMCTL_CMD")
    if [ -n "$policy_dir" ]; then
      health_args+=(--policy-dir "$policy_dir")
    fi
    if [ -n "$policy_parser_cmd" ]; then
      health_args+=(--policy-parser-cmd "$policy_parser_cmd")
    fi
    exec "$HEALTHCHECK_CMD" "${health_args[@]}"
    ;;
  audit)
    if [ ! -x "$AUDIT_CMD" ] && ! command -v "$AUDIT_CMD" >/dev/null 2>&1; then
      echo "audit tool not found: $AUDIT_CMD"
      exit 1
    fi
    if [ "$as_json" -eq 1 ]; then
      exec "$AUDIT_CMD" --install-root "$install_root" --workspace "$workspace" --shadow-cmd "$AUDIT_SHADOW_CMD" --json
    fi
    exec "$AUDIT_CMD" --install-root "$install_root" --workspace "$workspace" --shadow-cmd "$AUDIT_SHADOW_CMD"
    ;;
  repair)
    if [ ! -x "$REPAIR_CMD" ] && ! command -v "$REPAIR_CMD" >/dev/null 2>&1; then
      echo "repair tool not found: $REPAIR_CMD"
      exit 1
    fi
    repair_args=(--workspace "$workspace" --install-root "$install_root")
    if [ -n "$checks_csv" ]; then
      repair_args+=(--checks "$checks_csv")
    fi
    if [ "$list_checks" -eq 1 ]; then
      repair_args+=(--list-checks)
    fi
    if [ "$dry_run" -eq 1 ]; then
      repair_args+=(--dry-run)
    fi
    if [ -n "$report_file" ]; then
      repair_args+=(--report-file "$report_file")
    fi
    if [ -n "$report_dir" ]; then
      repair_args+=(--report-dir "$report_dir")
    fi
    if [ "${report_retain}" != "0" ]; then
      repair_args+=(--report-retain "$report_retain")
    fi
    if [ "$as_json" -eq 1 ]; then
      repair_args+=(--json)
    fi
    exec "$REPAIR_CMD" "${repair_args[@]}"
    ;;
  report-status)
    if [ ! -x "$REPORT_STATUS_CMD" ] && ! command -v "$REPORT_STATUS_CMD" >/dev/null 2>&1; then
      echo "report status tool not found: $REPORT_STATUS_CMD"
      exit 1
    fi
    status_args=()
    if [ -n "$report_dir" ]; then
      status_args+=(--report-dir "$report_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      status_args+=(--json)
    fi
    exec "$REPORT_STATUS_CMD" "${status_args[@]}"
    ;;
  broker-status)
    if [ ! -x "$BROKER_STATUS_CMD" ] && ! command -v "$BROKER_STATUS_CMD" >/dev/null 2>&1; then
      echo "broker status tool not found: $BROKER_STATUS_CMD"
      exit 1
    fi
    broker_args=(--workspace "$workspace")
    if [ "$as_json" -eq 1 ]; then
      broker_args+=(--json)
    fi
    exec "$BROKER_STATUS_CMD" "${broker_args[@]}"
    ;;
  evidence)
    if [ ! -x "$EVIDENCE_CMD" ] && ! command -v "$EVIDENCE_CMD" >/dev/null 2>&1; then
      echo "evidence tool not found: $EVIDENCE_CMD"
      exit 1
    fi
    evidence_args=(--workspace "$workspace")
    if [ -n "$install_root" ] && [ "$install_root" != "/" ]; then
      evidence_args+=(--install-root "$install_root")
    fi
    if [ -n "$metadata_path" ]; then
      evidence_args+=(--metadata "$metadata_path")
    fi
    if [ "$as_json" -eq 1 ]; then
      evidence_args+=(--json)
    fi
    exec "$EVIDENCE_CMD" "${evidence_args[@]}"
    ;;
  replay)
    if [ ! -x "$REPLAY_CMD" ] && ! command -v "$REPLAY_CMD" >/dev/null 2>&1; then
      echo "replay tool not found: $REPLAY_CMD"
      exit 1
    fi
    replay_args=(--workspace "$workspace" --limit "$event_limit")
    if [ -n "$session_id_filter" ]; then
      replay_args+=(--session-id "$session_id_filter")
    fi
    if [ "$as_json" -eq 1 ]; then
      replay_args+=(--json)
    fi
    exec "$REPLAY_CMD" "${replay_args[@]}"
    ;;
  approval-forensics)
    if [ ! -x "$APPROVAL_FORENSICS_CMD" ] && ! command -v "$APPROVAL_FORENSICS_CMD" >/dev/null 2>&1; then
      echo "approval forensics tool not found: $APPROVAL_FORENSICS_CMD"
      exit 1
    fi
    approval_args=(--workspace "$workspace" --limit "$event_limit")
    if [ -n "$session_id_filter" ]; then
      approval_args+=(--session-id "$session_id_filter")
    fi
    if [ "$as_json" -eq 1 ]; then
      approval_args+=(--json)
    fi
    exec "$APPROVAL_FORENSICS_CMD" "${approval_args[@]}"
    ;;
  case-export)
    if [ ! -x "$CASE_EXPORT_CMD" ] && ! command -v "$CASE_EXPORT_CMD" >/dev/null 2>&1; then
      echo "case export tool not found: $CASE_EXPORT_CMD"
      exit 1
    fi
    case_args=(--workspace "$workspace" --limit "$event_limit")
    if [ -n "$session_id_filter" ]; then
      case_args+=(--session-id "$session_id_filter")
    fi
    if [ -n "$install_root" ] && [ "$install_root" != "/" ]; then
      case_args+=(--install-root "$install_root")
    fi
    if [ -n "$metadata_path" ]; then
      case_args+=(--metadata "$metadata_path")
    fi
    if [ -n "$snapshot_label" ]; then
      case_args+=(--snapshot-label "$snapshot_label")
    fi
    if [ -n "$out_dir" ]; then
      case_args+=(--output "$out_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      case_args+=(--json)
    fi
    exec "$CASE_EXPORT_CMD" "${case_args[@]}"
    ;;
  validation-window)
    if [ ! -x "$VALIDATION_WINDOW_CMD" ] && ! command -v "$VALIDATION_WINDOW_CMD" >/dev/null 2>&1; then
      echo "validation window tool not found: $VALIDATION_WINDOW_CMD"
      exit 1
    fi
    window_args=(--workspace "$workspace")
    if [ -n "$install_root" ] && [ "$install_root" != "/" ]; then
      window_args+=(--install-root "$install_root")
    fi
    if [ -n "$metadata_path" ]; then
      window_args+=(--metadata "$metadata_path")
    fi
    if [ -n "$diagnostics_manifest" ]; then
      window_args+=(--diagnostics-manifest "$diagnostics_manifest")
    fi
    if [ -n "$report_dir" ]; then
      window_args+=(--history-dir "$report_dir")
    fi
    if [ -n "$snapshot_label" ]; then
      window_args+=(--snapshot-label "$snapshot_label")
    fi
    if [ -n "$out_dir" ]; then
      window_args+=(--output "$out_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      window_args+=(--json)
    fi
    exec "$VALIDATION_WINDOW_CMD" "${window_args[@]}"
    ;;
  control-history)
    if [ ! -x "$CONTROL_HISTORY_CMD" ] && ! command -v "$CONTROL_HISTORY_CMD" >/dev/null 2>&1; then
      echo "control history tool not found: $CONTROL_HISTORY_CMD"
      exit 1
    fi
    history_args=(--workspace "$workspace" --limit "$event_limit")
    if [ -n "$out_dir" ]; then
      history_args+=(--output "$out_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      history_args+=(--json)
    fi
    exec "$CONTROL_HISTORY_CMD" "${history_args[@]}"
    ;;
  review-pack)
    if [ ! -x "$REVIEW_PACK_CMD" ] && ! command -v "$REVIEW_PACK_CMD" >/dev/null 2>&1; then
      echo "review pack tool not found: $REVIEW_PACK_CMD"
      exit 1
    fi
    review_args=(--workspace "$workspace" --limit "$event_limit")
    if [ -n "$session_id_filter" ]; then
      review_args+=(--session-id "$session_id_filter")
    fi
    if [ -n "$install_root" ] && [ "$install_root" != "/" ]; then
      review_args+=(--install-root "$install_root")
    fi
    if [ -n "$metadata_path" ]; then
      review_args+=(--metadata "$metadata_path")
    fi
    if [ -n "$diagnostics_manifest" ]; then
      review_args+=(--diagnostics-manifest "$diagnostics_manifest")
    fi
    if [ -n "$report_dir" ]; then
      review_args+=(--history-dir "$report_dir")
    fi
    if [ -n "$snapshot_label" ]; then
      review_args+=(--snapshot-label "$snapshot_label")
    fi
    if [ -n "$out_dir" ]; then
      review_args+=(--output "$out_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      review_args+=(--json)
    fi
    exec "$REVIEW_PACK_CMD" "${review_args[@]}"
    ;;
  review-pack-history)
    if [ ! -x "$REVIEW_PACK_HISTORY_CMD" ] && ! command -v "$REVIEW_PACK_HISTORY_CMD" >/dev/null 2>&1; then
      echo "review pack history tool not found: $REVIEW_PACK_HISTORY_CMD"
      exit 1
    fi
    history_args=(--limit "$event_limit")
    if [ -n "$report_dir" ]; then
      history_args+=(--history-dir "$report_dir")
    fi
    if [ -n "$out_dir" ]; then
      history_args+=(--output "$out_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      history_args+=(--json)
    fi
    exec "$REVIEW_PACK_HISTORY_CMD" "${history_args[@]}"
    ;;
  review-packet)
    if [ ! -x "$REVIEW_PACKET_CMD" ] && ! command -v "$REVIEW_PACKET_CMD" >/dev/null 2>&1; then
      echo "review packet tool not found: $REVIEW_PACKET_CMD"
      exit 1
    fi
    packet_args=(--workspace "$workspace" --limit "$event_limit")
    if [ -n "$session_id_filter" ]; then
      packet_args+=(--session-id "$session_id_filter")
    fi
    if [ -n "$install_root" ] && [ "$install_root" != "/" ]; then
      packet_args+=(--install-root "$install_root")
    fi
    if [ -n "$metadata_path" ]; then
      packet_args+=(--metadata "$metadata_path")
    fi
    if [ -n "$diagnostics_manifest" ]; then
      packet_args+=(--diagnostics-manifest "$diagnostics_manifest")
    fi
    if [ -n "$report_dir" ]; then
      packet_args+=(--history-dir "$report_dir")
    fi
    if [ -n "$snapshot_label" ]; then
      packet_args+=(--snapshot-label "$snapshot_label")
    fi
    if [ -n "$out_dir" ]; then
      packet_args+=(--output "$out_dir")
    fi
    if [ "$as_json" -eq 1 ]; then
      packet_args+=(--json)
    fi
    exec "$REVIEW_PACKET_CMD" "${packet_args[@]}"
