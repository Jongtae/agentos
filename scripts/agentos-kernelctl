      shift
      recovery_reentry_after_slot_switch="${1:-}"
      ;;
    --checks)
      shift
      checks_csv="${1:-}"
      ;;
    --list-checks)
      list_checks=1
      ;;
    --report-file)
      shift
      report_file="${1:-}"
      ;;
    --feedback-file)
      shift
      feedback_file="${1:-}"
      ;;
